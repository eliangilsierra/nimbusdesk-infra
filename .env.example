# Copiar a .env y ajustar si hace falta. Son credenciales de desarrollo local
# únicamente (bases de datos descartables en contenedores), no usar en ningún
# entorno real.

MYSQL_ROOT_PASSWORD=nimbusdesk_dev
MYSQL_DATABASE=nimbusdesk

MSSQL_SA_PASSWORD=NimbusDesk_Dev1

# Compartido entre api-gateway (lo valida) e identity-service (lo firma). Debe
# coincidir en ambos — si lo cambiás, cambialo para los dos.
JWT_SECRET=nimbusdesk-dev-secret-change-me-nimbusdesk-dev-secret

# mysql | mssql — perfil activo del adaptador de persistencia en partner-bridge-service.
# Si lo pasás a "mssql", también hay que setear estas tres apuntando a esa base
# (por ejemplo PARTNER_BRIDGE_DB_URL=jdbc:sqlserver://mssql:1433;databaseName=nimbusdesk;encrypt=false,
# PARTNER_BRIDGE_DB_USERNAME=sa, PARTNER_BRIDGE_DB_PASSWORD=<MSSQL_SA_PASSWORD>).
# La base "nimbusdesk" no se crea sola en SQL Server: hay que crearla a mano una vez.
PARTNER_BRIDGE_PROFILE=mysql
PARTNER_BRIDGE_DB_URL=jdbc:mysql://mysql:3306/nimbusdesk
PARTNER_BRIDGE_DB_USERNAME=root
PARTNER_BRIDGE_DB_PASSWORD=nimbusdesk_dev
